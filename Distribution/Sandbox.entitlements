<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Opt-in App Sandbox entitlements for a Mac App Store build.
  Enable by setting CODE_SIGN_ENTITLEMENTS to this file and turning on the
  App Sandbox capability. See Distribution/Sandboxing.md.

  Note: a sandboxed build can only scan folders/disks the user explicitly picks
  (NSOpenPanel) and previously granted via security-scoped bookmarks. Scanning an
  entire startup disk requires the non-sandboxed build with Full Disk Access.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!-- Needed only if you keep the "Open With" feature launching other apps. -->
    <key>com.apple.security.automation.apple-events</key>
    <false/>
</dict>
</plist>
