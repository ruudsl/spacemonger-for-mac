<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd plist for the privileged helper daemon.
  Place at: SpaceMonger.app/Contents/Library/LaunchDaemons/net.slaats.SpaceMonger.Helper.plist
  Registered at runtime with SMAppService.daemon(plistName:).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.slaats.SpaceMonger.Helper</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/SpaceMongerHelper</string>
    <key>MachServices</key>
    <dict>
        <key>net.slaats.SpaceMonger.Helper</key>
        <true/>
    </dict>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>net.slaats.SpaceMonger</string>
    </array>
</dict>
</plist>
