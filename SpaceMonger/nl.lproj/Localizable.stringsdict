<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Add %lld to Collector</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@v@</string>
        <key>v</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Voeg %lld item toe aan verzamelaar</string>
            <key>other</key>
            <string>Voeg %lld items toe aan verzamelaar</string>
        </dict>
    </dict>
    <key>%lld items</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@v@</string>
        <key>v</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld item</string>
            <key>other</key>
            <string>%lld items</string>
        </dict>
    </dict>
    <key>Move %lld to Trash</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@v@</string>
        <key>v</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Verplaats %lld item naar prullenmand</string>
            <key>other</key>
            <string>Verplaats %lld items naar prullenmand</string>
        </dict>
    </dict>
    <key>Delete %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@v@</string>
        <key>v</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Verwijder %lld item</string>
            <key>other</key>
            <string>Verwijder %lld items</string>
        </dict>
    </dict>
</dict>
</plist>
