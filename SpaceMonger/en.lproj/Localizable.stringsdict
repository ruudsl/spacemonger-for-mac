<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Add %lld to Collector</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@v@</string>
        <key>v</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Add %lld item to Collector</string>
            <key>other</key>
            <string>Add %lld items to Collector</string>
        </dict>
    </dict>
    <key>%lld items</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@v@</string>
        <key>v</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld item</string>
            <key>other</key>
            <string>%lld items</string>
        </dict>
    </dict>
    <key>Move %lld to Trash</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@v@</string>
        <key>v</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Move %lld item to Trash</string>
            <key>other</key>
            <string>Move %lld items to Trash</string>
        </dict>
    </dict>
    <key>Delete %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@v@</string>
        <key>v</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Delete %lld item</string>
            <key>other</key>
            <string>Delete %lld items</string>
        </dict>
    </dict>
</dict>
</plist>
